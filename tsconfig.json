{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "strict": true,
    "paths": {
      "@/*": ["src/*"],
      "@/assets/*": ["assets/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
